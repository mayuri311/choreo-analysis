# `npx supabase start` prints these for local dev; use your project's values in production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (no NEXT_PUBLIC_ prefix!). Used by captains' invite/remove actions.
# Supabase dashboard → Project Settings → API keys → service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=
